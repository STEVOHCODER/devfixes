{
  "name": "devfixes-error-search",
  "displayName": "DevFixes Error Search",
  "description": "Search or debug selected error text with DevFixes.",
  "version": "0.1.0",
  "publisher": "devfixes",
  "license": "MIT",
  "homepage": "https://devfixes.vercel.app/resources/vscode",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "devfixes.searchSelectedError",
        "title": "DevFixes: Search Selected Error"
      },
      {
        "command": "devfixes.debugSelectedError",
        "title": "DevFixes: Debug Selected Error"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "devfixes.searchSelectedError",
          "group": "navigation@90",
          "when": "editorHasSelection"
        },
        {
          "command": "devfixes.debugSelectedError",
          "group": "navigation@91",
          "when": "editorHasSelection"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "package": "vsce package --allow-missing-repository --out ../../public/downloads/devfixes-error-search-0.1.0.vsix"
  },
  "devDependencies": {
    "@types/vscode": "1.95.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.9.2"
  }
}
